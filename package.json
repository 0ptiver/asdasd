{
  "name": "timber-empire",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src tests e2e scripts",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "test:e2e": "playwright test",
    "server": "tsx src/net/server/index.ts",
    "economy": "tsx scripts/economy.ts --write",
    "test:all": "npm run validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "idb": "^8.0.3",
    "preact": "^11.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
